# empatIA - Configurações de Ambiente
# Copie este arquivo para .env e configure suas chaves

# ===== MONGODB =====
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=empatia
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/empatia?authSource=admin
DATABASE_NAME=empatia
MONGODB_PORT=27017

# ===== GCP SERVICE =====
CREDENTIALS_JSON=

# ===== AI SERVICE =====
# Minimal setup (local LM Studio + future K8s/prod endpoint)
# Tipos de LLM_PROVIDER:
# - openai: usa cliente OpenAI-compatible (OpenAI Cloud ou endpoint compatível local)
# - local: alias de openai para indicar uso local (LM Studio/Ollama compatível)
LLM_PROVIDER=openai
# LM Studio no host em http://127.0.0.1:1234
# Com ai-service em network_mode=host, mantenha 127.0.0.1
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Alias explícito (opcional): se definido, tem prioridade sobre LLM_BASE_URL.
OPENAI_ENDPOINT=
# Alias explícito (opcional): se definido, tem prioridade sobre MODEL_NAME.
OPENAI_MODEL=
MODEL_NAME=gemma-4-e4b
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=lm-studio
# Legacy/compat vars (optional)
OPENAI_BASE_URL=
OPENAI_COMPLETIONS_URL=
# Exemplo OpenAI Cloud:
# OPENAI_ENDPOINT=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-...
AI_SERVICE_PORT=8001
TEMPERATURE=0.3
MAX_TOKENS=700
# Para LM Studio local, a análise/finalização de sessão pode demorar bem mais.
LLM_REQUEST_TIMEOUT_SECONDS=240
# ai-service em network_mode=host (Linux): use serviços locais
AI_MONGODB_URI=mongodb://admin:admin123@127.0.0.1:27017/empatia?authSource=admin
AI_REDIS_URL=redis://127.0.0.1:6379/0
# Runtime retrieval (AI Service -> Knowledge Service)
KNOWLEDGE_RETRIEVE_TIMEOUT_SECONDS=8

# ===== KNOWLEDGE SERVICE =====
# Admin-controlled RAG foundation
KNOWLEDGE_SERVICE_PORT=8005
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8005
KNOWLEDGE_STORAGE_BACKEND=in-memory
KNOWLEDGE_STORAGE_DIR=/knowledge_data
KNOWLEDGE_LEXICAL_INDEX=sqlite-fts5-planned
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6333

# ===== EMOTION SERVICE =====
# OpenFace Configuration
OPENFACE_MODEL_PATH=/models/openface
EMOTION_CONFIDENCE_THRESHOLD=0.7
EMOTION_SERVICE_PORT=8003
USE_LEGACY_FALLBACK=false
FORCE_LEGACY_PROCESSOR=false
DEEPFACE_DETECTOR_BACKEND=retinaface
DEEPFACE_DETECTOR_BACKENDS=retinaface,opencv
# GPU policy: AI Service owns the GPU by default; Emotion Service runs on CPU.
EMOTION_NVIDIA_VISIBLE_DEVICES=none
EMOTION_CUDA_VISIBLE_DEVICES=-1
EMOTION_NVIDIA_DRIVER_CAPABILITIES=compute,utility

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:7860,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# ===== WEB UI =====
# Frontend Configuration
WEB_UI_PORT=7860
BACKEND_URL=http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8001

# ===== DATABASE =====
# PostgreSQL Configuration (quando implementado)
POSTGRES_DB=empatia
POSTGRES_USER=empatia_user
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql://empatia_user:strong_password_here@db:5432/empatia

# ===== REDIS =====
# Cache Configuration (quando implementado)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here

# ===== MONITORING =====
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin_password_here

# Jaeger
JAEGER_PORT=16686

# ===== SECURITY =====
# JWT Configuration (quando implementado)
SECRET_KEY=your_super_secret_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ===== DEVELOPMENT =====
# Debug Mode
DEBUG=true

# Hot Reload
HOT_RELOAD=true

# ===== PRODUCTION =====
# Quando em produção, altere estas configurações:
# DEBUG=false
# HOT_RELOAD=false
# LOG_LEVEL=WARNING

# SSL Configuration (produção)
# SSL_CERT_PATH=/certs/cert.pem
# SSL_KEY_PATH=/certs/key.pem

# ===== EXTERNAL SERVICES =====
# Webhook URLs (futuro)
# WEBHOOK_EMOTION_ANALYSIS=https://your-webhook.com/emotion
# WEBHOOK_CONVERSATION_END=https://your-webhook.com/conversation

# Email Configuration (futuro)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password

# ===== OBSERVABILITY =====
# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-dsn-here

# DataDog (APM)
# DD_API_KEY=your_datadog_api_key
# DD_APP_KEY=your_datadog_app_key

# ===== BACKUP =====
# S3 Configuration for backups
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET_NAME=empatia-backups
# AWS_REGION=us-east-1 
